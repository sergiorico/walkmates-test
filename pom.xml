<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: pins consistent, Java-21-compatible versions for
         JUnit 5, Mockito, AssertJ, Jackson, etc. via spring-boot-starter-test. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.walkmates</groupId>
    <artifactId>walkmates</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>WalkMates</name>
    <description>
        A teaching system for the Software Testing course (DV033G, HT26).
        WalkMates matches people who want time with animals (dog walking,
        pet/house sitting, day visits, shelter volunteering) with the owners
        and shelters who need it. The codebase exists to be a good thing to
        TEST: it exposes clean, boundary-friendly, mockable seams for Labs 1-3.
    </description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Quality tooling versions -->
        <jacoco.version>0.8.12</jacoco.version>
        <!-- PIT 1.15.8 + junit5 plugin 1.2.1 is the combination proven on the BikeShare repo. -->
        <pit.version>1.15.8</pit.version>
        <pit.junit5.version>1.2.1</pit.junit5.version>
    </properties>

    <dependencies>
        <!-- Web layer: REST controllers (Lab 3 interface testing) + thin Thymeleaf UI -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- H2 in-memory DB (dev/demo). Repositories are in-memory by default;
             H2 is here for the "stretch" persistence option mentioned in the labs. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing: JUnit 5 + Mockito + AssertJ + Spring MockMvc all come via this starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot packaging / `mvn spring-boot:run` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- JaCoCo: line/branch coverage (Lab 2 structural testing).
                 No minimum gate in the student repo - coverage is reported, not enforced. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- PIT mutation testing (Lab 2 test-quality work).
                 Targets the business logic where mutants are interesting. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pit.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pit.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.walkmates.model.*</param>
                        <param>com.walkmates.service.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.walkmates.*</param>
                    </targetTests>
                    <excludedClasses>
                        <param>com.walkmates.WalkMatesApplication</param>
                        <param>com.walkmates.web.*</param>
                        <param>com.walkmates.config.*</param>
                    </excludedClasses>
                    <excludedMethods>
                        <param>toString</param>
                        <param>hashCode</param>
                        <param>equals</param>
                    </excludedMethods>
                    <outputFormats>
                        <outputFormat>HTML</outputFormat>
                        <outputFormat>XML</outputFormat>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>2</threads>
                    <timeoutConstant>5000</timeoutConstant>
                    <verbose>true</verbose>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
